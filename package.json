{
	"name": "mpcs_testbench_dashboard",
	"version": "1.6.1",
	"description": "",
	"main": "src/main.js",
	"build": {
		"appId": "com.mpcs.testbench.dashboard",
		"productName": "MPCS Testbench Dashboard",
		"directories": {
			"output": "dist"
		},
		"extraResources": [
			"assets/seed.db"
		],
		"win": {
			"target": "nsis"
		},
		"nsis": {
			"oneClick": false,
			"allowToChangeInstallationDirectory": true,
			"include": "installer.nsh"
		},
		"linux": {
			"target": "AppImage",
			"category": "Utility"
		}
	},
	"scripts": {
		"prestart": "node -e \"const fs=require('fs');const p=require('path');const f=p.join(process.env.APPDATA || (process.platform == 'darwin' ? process.env.HOME + '/Library/Application Support' : process.env.HOME + '/.config'), 'mpcs_testbench_dashboard', 'database.sqlite');if(fs.existsSync(f))fs.unlinkSync(f);\"",
		"start:factory": "electron .",
		"start:prod": "electron .",
		"postinstall": "npm_config_build_from_source=true electron-rebuild -f -w sqlite3",
		"rebuild": "electron-rebuild -f -w sqlite3",
		"pack": "electron-builder --dir",
		"predist": "node create-seed.js",
		"dist": "electron-builder",
		"test": "jest",
		"e2e": "playwright test",
		"format:check": "biome format .",
		"format:fix": "biome format --write .",
		"lint": "biome lint .",
		"lint:fix": "biome check --write .",
		"ci": "biome check ."
	},
	"keywords": [],
	"author": "",
	"license": "ISC",
	"type": "commonjs",
	"dependencies": {
		"bonjour-service": "^1.4.3",
		"electron-log": "^5.4.3",
		"modbus-serial": "^8.0.25",
		"sqlite3": "^6.0.1",
		"winston": "^3.19.0",
		"winston-syslog": "^2.7.1"
	},
	"devDependencies": {
		"@biomejs/biome": "2.4.15",
		"@electron/rebuild": "^4.0.4",
		"@playwright/test": "^1.60.0",
		"electron": "^32.3.0",
		"electron-builder": "^26.8.1",
		"jest": "^30.4.2"
	},
	"jest": {
		"testMatch": [
			"**/*.test.js"
		]
	}
}
